#!/usr/bin/env bash
# SO101 policy rollout — drive the follower with a trained ACT policy.
#
#   ./so101/rollout --dry      # print the command, touch nothing
#   ./so101/rollout            # 5 s smoke, stock policy
#   ./so101/rollout 20         # 20 s
#   POLICY=lighting ./so101/rollout 20
#   DISPLAY_DATA=1 ./so101/rollout 20    # watch it (JPEG-compressed)
#   DISPLAY_DATA=raw ./so101/rollout 20  # watch it (raw frames)
#
# DISPLAY_DATA: 0 = off (default) | 1 = rerun with JPEG frames | raw = rerun
# with uncompressed frames. base.py logs every step via _log_telemetry, so at
# "raw" both camera frames (~3.6 MB) cross the wire per control step, ~108
# MB/s, and rerun's own log shows its 1 GiB buffer overrun 11 s into a 20 s
# run. Measured here: cameras sustain 30.0 Hz and ACT inference 161 Hz, so
# nothing else on the loop can account for the 5-6 Hz observed with raw on.
# "1" is the same view at roughly 20-30x less bandwidth -- whether that is
# enough to hold 30 Hz is exactly what the raw-vs-1 comparison answers.
# Scored trials should use whichever holds 30 Hz; when unsure, 0.
#
# Single-token launcher: this terminal splits long multi-line pastes
# (so101/STATUS.md), so the whole lerobot-rollout invocation lives here.
#
# SAFETY: the follower energizes on connect and then moves under policy
# control. Clear the swept volume and keep power/e-stop in reach. Do NOT
# connect the leader — the policy drives the arm, not you.
#
# Camera geometry is fixed to what pick_place_v3 trained on (front 640x480,
# wrist 1280x720, 30 fps). Do not change it without retraining.
set -euo pipefail

SO101_DIR="$(cd "$(dirname "$0")" && pwd)"
LMFAO_DIR="$(cd "$SO101_DIR/.." && pwd)"

# The serial port is dialout-only. A shell opened before the user was added to
# that group does not carry it, so re-exec once under sg rather than making the
# operator do it by hand. The guard stops this from recursing.
# (-w reflects this process's real credentials; `id -nG $USER` would not, as it
# reads the group database rather than the shell's own group set.)
if [[ -e "${FOLLOWER_PORT:-/dev/so101_follower}" && ! -w "${FOLLOWER_PORT:-/dev/so101_follower}" \
      && -z "${SO101_SG_REEXEC:-}" ]] && getent group dialout | grep -qw "$(whoami)"; then
  export SO101_SG_REEXEC=1
  exec sg dialout -c "$(printf '%q ' "$0" "$@")"
fi

# shellcheck disable=SC1091
source "$SO101_DIR/env.sh"

DRY=0
[[ "${1:-}" == "--dry" ]] && { DRY=1; shift; }

DURATION="${1:-5}"
POLICY_NAME="${POLICY:-stock}"
POLICY_PATH="${POLICY_PATH:-$LMFAO_DIR/policies/$POLICY_NAME}"
TASK="${TASK:-pick the blue puck and place it in the brown box}"
FPS="${FPS:-30}"
PORT="${FOLLOWER_PORT:-/dev/so101_follower}"
# off | 1 (JPEG-compressed) | raw (uncompressed, the cadence-killer)
case "${DISPLAY_DATA:-0}" in
  raw|RAW)        DISPLAY_DATA=true;  COMPRESS=false ;;
  1|true|jpeg)    DISPLAY_DATA=true;  COMPRESS=true  ;;
  *)              DISPLAY_DATA=false; COMPRESS=true  ;;
esac

# --- pre-flight -------------------------------------------------------------
[[ -f "$POLICY_PATH/model.safetensors" ]] || {
  echo "no policy at $POLICY_PATH" >&2
  echo "  copy one from RunPod first (docs/policytraining_v3.md 1.2)" >&2
  exit 1; }

for f in config.json policy_preprocessor.json policy_postprocessor.json; do
  [[ -f "$POLICY_PATH/$f" ]] || {
    echo "$POLICY_PATH is incomplete: missing $f" >&2
    echo "  LeRobot needs the whole pretrained_model dir, not just weights" >&2
    exit 1; }
done

[[ -e "$PORT" ]] || { echo "follower not found at $PORT — is it plugged in?" >&2; exit 1; }
if [[ ! -r "$PORT" || ! -w "$PORT" ]]; then
  echo "cannot access $PORT — $USER is not in the dialout group." >&2
  echo "  fix: sudo usermod -aG dialout $USER, then log out and back in" >&2
  exit 1
fi

[[ -f "$SO101_DIR/front_cam.path" && -f "$SO101_DIR/wrist_cam.path" ]] || {
  echo "camera pins missing — run: python so101/eval/cam_check.py --find-front && --find" >&2
  exit 1; }

FRONT="$(readlink -f "$(cat "$SO101_DIR/front_cam.path")")"
WRIST="$(readlink -f "$(cat "$SO101_DIR/wrist_cam.path")")"
[[ -e "$FRONT" ]] || { echo "front cam $FRONT missing — re-pin with cam_check.py --find-front" >&2; exit 1; }
[[ -e "$WRIST" ]] || { echo "wrist cam $WRIST missing — re-pin with cam_check.py --find" >&2; exit 1; }
[[ "$FRONT" != "$WRIST" ]] || { echo "front and wrist resolve to the same device" >&2; exit 1; }

# warmup_s=4, not LeRobot's default 1. The RealSense front cam needs ~3 s for
# auto-exposure/white-balance to converge: measured B/R 0.518 -> 0.892 and
# brightness 38 -> 112 over the first 3 s, against demos at B/R 0.910+/-0.012
# and brightness 113.0+/-1.5. At warmup_s=1 the policy's FIRST observation is
# ~20 sigma off the training distribution -- and ACT plans a whole 100-action
# chunk (3.3 s of motion) from it. See CHECKPOINT.md's pre-rollout scene gate.
CAMERAS="{ \
front: {type: opencv, index_or_path: ${FRONT}, width: 640, height: 480, fps: 30, fourcc: MJPG, warmup_s: 4}, \
wrist: {type: opencv, index_or_path: ${WRIST}, width: 1280, height: 720, fps: 30, fourcc: MJPG, warmup_s: 4} \
}"

echo "policy   : $POLICY_NAME  ($POLICY_PATH)"
echo "duration : ${DURATION}s @ ${FPS} fps"
echo "cameras  : front=$FRONT (640x480)  wrist=$WRIST (1280x720)"
echo "task     : $TASK"
if [[ "$DISPLAY_DATA" == "true" ]]; then
  echo "rerun    : on, $([[ "$COMPRESS" == "true" ]] && echo 'JPEG frames' || echo 'RAW frames — expect the loop to fall below 30 Hz')"
else
  echo "rerun    : off"
fi
echo

if [[ "$DRY" == "1" ]]; then
  echo "--dry: pre-flight passed, nothing was run. Remove --dry to drive the arm."
  exit 0
fi

if [[ "${ROLLOUT_YES:-0}" != "1" ]]; then
  echo "The follower will ENERGIZE and MOVE. Ctrl-C or cut power to stop."
  read -r -p "Workspace clear? [y/N] " ok
  [[ "$ok" == "y" || "$ok" == "Y" ]] || { echo "aborted"; exit 1; }
fi

exec lerobot-rollout \
  --strategy.type=base \
  --robot.type=so101_follower \
  --robot.port="$PORT" \
  --robot.id=follower \
  --robot.cameras="$CAMERAS" \
  --policy.path="$POLICY_PATH" \
  --policy.device=cpu \
  --device=cpu \
  --task="$TASK" \
  --fps="$FPS" \
  --duration="$DURATION" \
  --display_data="$DISPLAY_DATA" \
  --display_compressed_images="$COMPRESS" \
  --return_to_initial_position=true
