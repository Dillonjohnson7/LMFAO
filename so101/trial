#!/usr/bin/env bash
# One scored trial, end to end: start pose -> gates -> rollout.
#
#   ./so101/trial                  # 20 s, stock, rerun off
#   ./so101/trial 30               # 30 s
#   POLICY=lighting ./so101/trial  # another bucket
#   DISPLAY_DATA=1 ./so101/trial   # watch it (JPEG-compressed, see below)
#   SKIP_POSE=1 ./so101/trial      # rollout without re-homing the arm
#
# One token, one confirmation, three stages -- this terminal splits long
# multi-line pastes (so101/STATUS.md), and chaining these by hand is how a
# stage gets silently skipped and a trial gets scored that should not have been.
#
# Stage 2 is a hard gate: if the scene, pose or policy is off-distribution the
# rollout does NOT run. A trial from a drifted setup measures the setup.
set -euo pipefail

SO101_DIR="$(cd "$(dirname "$0")" && pwd)"
DUR="${1:-20}"
POLICY_NAME="${POLICY:-stock}"

B=$'\033[1m'; G=$'\033[32m'; R=$'\033[31m'; Y=$'\033[33m'; X=$'\033[0m'
step() { echo; echo "${B}=== $1 ===${X}"; }

echo "${B}TRIAL${X}  policy=${POLICY_NAME}  duration=${DUR}s  rerun=${DISPLAY_DATA:-0}"
echo "The arm will move twice: once to the start pose, then under policy control."
if [[ "${TRIAL_YES:-0}" != "1" ]]; then
  read -r -p "Workspace clear? [y/N] " ok
  [[ "$ok" == "y" || "$ok" == "Y" ]] || { echo "aborted"; exit 1; }
fi

if [[ "${SKIP_POSE:-0}" != "1" ]]; then
  step "1/3  start pose"
  # Not fatal on its own: goto_start exits 1 when it stops short, and the
  # preflight gate below is what actually decides whether to roll.
  "$SO101_DIR/eval_py" goto_start.py --yes || echo "${Y}goto_start did not converge — the gate decides${X}"
else
  step "1/3  start pose (skipped)"
fi

step "2/3  gates"
if ! "$SO101_DIR/eval_py" preflight.py; then
  echo
  echo "${R}${B}TRIAL ABORTED${X} — gates failed, so the arm was not driven."
  echo "Fix what is flagged above, or re-run. Nothing was scored."
  exit 1
fi

step "3/3  rollout"
TRIAL_YES=1 ROLLOUT_YES=1 POLICY="$POLICY_NAME" "$SO101_DIR/rollout" "$DUR"

echo
echo "${G}${B}TRIAL COMPLETE${X} — policy=${POLICY_NAME} ${DUR}s"
echo "Score it now: grasp / transport / placement, plus any intervention."
