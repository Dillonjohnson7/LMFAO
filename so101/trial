#!/usr/bin/env bash
# One trial, always recorded.
#
#   ./so101/trial                  # 90 s, stock
#   ./so101/trial 45               # shorter
#   POLICY=lighting ./so101/trial
#   DISPLAY_DATA=1 ./so101/trial   # also stream to rerun
#
# This is a thin wrapper over ./so101/series with one episode. There used to be
# a separate non-recording path here, and runs kept being lost to it: a trial
# worth watching is a trial worth having on disk, so there is now one command
# and it always saves.
set -euo pipefail

SO101_DIR="$(cd "$(dirname "$0")" && pwd)"
DUR="${1:-90}"
exec env EPISODE_S="$DUR" "$SO101_DIR/series" 1
