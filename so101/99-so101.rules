# SO101 arms — stable device names by USB serial (CH343, 1a86:55d3)
# LEADER  = serial 5B14111261  -> /dev/so101_leader
# FOLLOWER = serial 5B14111358 -> /dev/so101_follower
SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="1a86", ENV{ID_MODEL_ID}=="55d3", ENV{ID_SERIAL_SHORT}=="5B14111261", SYMLINK+="so101_leader", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ENV{ID_VENDOR_ID}=="1a86", ENV{ID_MODEL_ID}=="55d3", ENV{ID_SERIAL_SHORT}=="5B14111358", SYMLINK+="so101_follower", GROUP="dialout", MODE="0660"
