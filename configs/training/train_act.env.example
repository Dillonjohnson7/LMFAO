# Copy outside the repo (or gitignored) and fill in for train_eval_buckets.sh.

# Freshly recorded demos (output of scripts/record_demos.sh / lerobot-record)
STOCK=/data/pick_place_v3

# Buckets produced by scripts/augment_eval_buckets.sh
OUT_ROOT=/data/eval_buckets
RUNS_ROOT=/data/runs/eval_buckets

# Matched training knobs across buckets
POLICY_DEVICE=cuda
STEPS=100000
BATCH_SIZE=8
SEED=7
SAVE_CHECKPOINT=true
WANDB_ENABLE=false
HF_USER=Dillonjohnson
LEROBOT_BIN=/workspace/v312/bin/lerobot-train
