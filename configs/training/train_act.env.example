# Copy outside the repo (or gitignored) and fill in for train_eval_arms.sh.

# Freshly recorded demos (output of scripts/record_demos.sh / lerobot-record)
STOCK=/data/pick_place_v3

# Arms produced by scripts/augment_eval_arms.sh
OUT_ROOT=/data/eval_arms
RUNS_ROOT=/data/runs/eval_arms

# Matched training knobs across arms
POLICY_DEVICE=cuda
STEPS=100000
BATCH_SIZE=8
SEED=7
SAVE_CHECKPOINT=true
WANDB_ENABLE=false
HF_USER=Dillonjohnson
LEROBOT_BIN=/workspace/v312/bin/lerobot-train
