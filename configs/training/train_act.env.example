# Copy to train_act.env (outside the repo, or gitignored) and fill in.
# Used by scripts/train_act.sh on a GPU pod.

DATASET_ROOT=/data/pick_place_v2_augmented
DATASET_REPO_ID=Dillonjohnson/pick_place_v2_augmented
OUTPUT_DIR=/data/runs/act_pick_place_v2_aug
POLICY_DEVICE=cuda
STEPS=100000
BATCH_SIZE=8
SEED=7
SAVE_CHECKPOINT=true
WANDB_ENABLE=false
